# Copy to backend/.env (never commit .env). The app, Alembic and the tests load
# it automatically; variables already exported in your shell take precedence.

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

# Optional. A GitHub personal access token raises the API rate limit
# from 60 to 5,000 requests/hour. Public repos work without it.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Largest file size (bytes) the file viewer will load. Default: 512000 (500 KB).
MAX_FILE_SIZE_BYTES=512000

# Chunking (characters). See README for why these defaults were chosen.
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

# Repository analysis limits
MAX_ARCHIVE_BYTES=104857600
MAX_FILES_PER_ANALYSIS=3000
MAX_CHUNK_FILE_BYTES=204800
ANALYSIS_CACHE_SIZE=2
ANALYSIS_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------- database (Phase 5)
# PostgreSQL connection string. Replace the placeholders; keep real credentials in .env only.
# Without it the app still runs, but /api/repos/analyze, /index-status and
# /{id}/chunks return 503.
DATABASE_URL=postgresql://repomind:CHANGE_ME@localhost:5432/repomind

# Separate database for the test suite. The tests DELETE ITS DATA, and they refuse to run
# if it equals DATABASE_URL. Leave empty to skip the database tests.
TEST_DATABASE_URL=postgresql://repomind:CHANGE_ME@localhost:5432/repomind_test

# Log every SQL statement (debugging only).
DATABASE_ECHO=false

# ---------------------------------------------------------------- embeddings (Phase 6)
# Google Gemini API key (https://aistudio.google.com/apikey). Backend only: never put it
# in the frontend or commit it. Without it, POST /api/repos/{id}/embeddings returns 503.
GEMINI_API_KEY=

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(N) column. Changing it requires a new migration (see README).
EMBEDDING_DIMENSIONS=768
# Chunks per provider request (1-100; Gemini accepts at most 100).
EMBEDDING_BATCH_SIZE=50
# One POST works for about this long, then returns progress; call again to continue.
EMBEDDING_REQUEST_BUDGET_SECONDS=15
# Retries per batch for rate limits / provider errors / network errors.
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- answers / RAG (Phase 8)
# Uses the same GEMINI_API_KEY. Without it, POST /api/repos/{id}/ask returns 503.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# low | medium | high, or empty for the model default. Thinking tokens are billed as output.
LLM_THINKING_LEVEL=low
# Upper bound on answer + thinking tokens per question.
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# Retries stop once a question has taken this long.
LLM_REQUEST_BUDGET_SECONDS=45
# Maximum characters of retrieved code sent with one question (about 4 characters per token).
RAG_MAX_CONTEXT_CHARS=24000
# Answers whose best source is less similar than this get a "weak evidence" warning (0-1).
RAG_WEAK_SIMILARITY=0.5
